{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-heaven.dev/schema/runtime-observation-v1.schema.json",
  "title": "Skill Zero runtime observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sessionPseudonym", "observedAt", "harness", "composition", "signals", "metrics"],
  "properties": {
    "schema": { "const": "gaia.skill-zero-runtime-observation/v1" },
    "sessionPseudonym": { "type": "string", "pattern": "^szs_[a-f0-9]{64}$" },
    "observedAt": { "type": "string", "format": "date-time" },
    "harness": { "$ref": "#/$defs/versionedIdentity" },
    "model": { "$ref": "#/$defs/modelIdentity" },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posture", "loadedSkills"],
      "properties": {
        "posture": { "enum": ["floor", "product-floor", "curated", "native"] },
        "mechanism": { "enum": ["plugin-dir", "config-dir"] },
        "loadedSkills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "contentSha256", "invocationObserved"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 256 },
              "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "invocationObserved": { "type": ["boolean", "null"], "enum": [true, null] }
            }
          }
        }
      }
    },
    "taskFamily": { "type": "string", "minLength": 1, "maxLength": 128 },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "retryCount", "recoveryObserved", "churnCount"],
      "properties": {
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "exitCode"],
          "properties": {
            "status": { "enum": ["succeeded", "failed"] },
            "exitCode": { "type": "integer", "minimum": 0 }
          }
        },
        "retryCount": { "type": ["integer", "null"], "minimum": 0 },
        "recoveryObserved": { "type": ["boolean", "null"] },
        "churnCount": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latencyMs"],
      "properties": {
        "latencyMs": { "type": "integer", "minimum": 0 },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "input": { "type": "integer", "minimum": 0 },
            "output": { "type": "integer", "minimum": 0 },
            "cacheCreationInput": { "type": "integer", "minimum": 0 },
            "cacheReadInput": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  },
  "$defs": {
    "versionedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "modelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
